# Banco (Supabase Postgres). Sem isso o painel roda 100% em mock.
# Supabase → Connect → Transaction pooler (porta 6543), com a senha do banco no lugar do placeholder.
DATABASE_URL=

# Shopify — escopos read_orders, read_all_orders, read_checkouts, read_products (passo a passo em docs/03-shopify.md)
# handle da loja: admin.shopify.com/store/<handle> → <handle>.myshopify.com
SHOPIFY_STORE_DOMAIN=
SHOPIFY_API_VERSION=2026-01
# App do Dev Dashboard (padrão desde 2026): token de 24h gerado a partir destes dois
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Ou: token fixo shpat_ de app personalizado antigo (tem prioridade se preenchido)
SHOPIFY_ADMIN_TOKEN=

# Olist ERP (ex-Tiny) — API v2: token fixo da conta, gerado no painel da Olist. Ver docs/04-olist.md
OLIST_TOKEN=

# Olist API v3 (OAuth2) — caminho alternativo, não usado hoje; `npm run olist:auth` grava .olist-token.json
OLIST_CLIENT_ID=
OLIST_CLIENT_SECRET=
OLIST_REDIRECT_URI=http://localhost:8787/olist/callback

# Meta Marketing API — System User token
META_AD_ACCOUNT_ID=act_
META_ACCESS_TOKEN=

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Segredo para o cron da Vercel chamar /api/sync/*
CRON_SECRET=
